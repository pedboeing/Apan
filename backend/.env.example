# Copie este arquivo para .env e ajuste os valores conforme seu ambiente local.

# Conexão com o banco PostgreSQL local
DATABASE_URL="postgresql://apan:apan@localhost:5432/apan_dev?schema=public"

# Porta em que a API Express roda localmente
PORT=3333

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório
# forte antes de ir para produção
JWT_SECRET="dev-secret-troque-em-producao"

# Validade do token de sessão
JWT_EXPIRES_IN="30d"

# Código que um técnico precisa informar no cadastro para se registrar como
# TECNICO (medida simples anti-cadastro-indevido; evoluir para convites
# individuais mais adiante)
TECNICO_INVITE_CODE="apan-tecnico-2026"
