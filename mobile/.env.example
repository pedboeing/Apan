# Copie para .env e ajuste conforme seu ambiente.
#
# URL da API backend. No emulador Android use 10.0.2.2 em vez de localhost;
# em um celular físico com Expo Go, use o IP da sua máquina na rede local
# (ex: http://192.168.0.10:3333), já que "localhost" no celular aponta para
# o próprio celular, não para o computador rodando o backend.
EXPO_PUBLIC_API_URL=http://localhost:3333
